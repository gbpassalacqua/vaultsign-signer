{
  "manifest_version": 3,
  "name": "VaultSign Signer (Dev)",
  "version": "0.1.1",
  "description": "Bridges vaultsign.app to ICP-Brasil certificates installed on this machine.",
  "permissions": ["nativeMessaging"],
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": [
      "https://vaultsign.app/*",
      "https://*.vaultsign.app/*",
      "http://localhost:8080/*",
      "https://*.vercel.app/*"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:8080/*",
        "https://vaultsign.app/*",
        "https://*.vaultsign.app/*",
        "https://*.vercel.app/*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "key": ""
}
