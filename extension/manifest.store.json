{
  "manifest_version": 3,
  "name": "VaultSign Signer",
  "version": "0.1.0",
  "description": "Sign documents on vaultsign.app with your ICP-Brasil digital certificate. Qualified electronic signature (MP 2.200-2/01).",
  "author": "VaultSign / Rocket99 Ventures LLC",
  "homepage_url": "https://vaultsign.app",
  "permissions": ["nativeMessaging"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://vaultsign.app/*",
        "https://*.vaultsign.app/*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
